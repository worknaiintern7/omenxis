# ⚠️  NEVER commit real credentials. Copy this file to .env and fill in your values.
PORT=5000
MONGO_URI=mongodb://<db_user>:<db_password>@<cluster>.mongodb.net/<dbname>?ssl=true&replicaSet=<replicaSet>&authSource=admin&retryWrites=true&w=majority
JWT_SECRET=<your_jwt_secret_min_32_chars>
JWT_EXPIRES_IN=7d

ALLOWED_ORIGIN=*

# Firebase
FIREBASE_PROJECT_ID=<your_firebase_project_id>
FIREBASE_PROJECT_NUMBER=<your_firebase_project_number>
FIREBASE_APP_ID=<your_firebase_app_id>
GOOGLE_APPLICATION_CREDENTIALS=./src/config/serviceAccountKey.json
