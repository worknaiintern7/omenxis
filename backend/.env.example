NODE_ENV=production
PORT=5000
MONGO_URI=mongodb://<db_user>:<db_password>@<cluster>.mongodb.net/<dbname>?ssl=true&replicaSet=<replicaSet>&authSource=admin&retryWrites=true&w=majority
JWT_SECRET=<your_jwt_secret_min_32_chars>
JWT_EXPIRES_IN=7d

ALLOWED_ORIGIN=*

ADMIN_EMAIL=admin@example.com
ADMIN_USERNAME=admin
ADMIN_PASSWORD=<strong_admin_password>

FIREBASE_PROJECT_ID=<your_firebase_project_id>
FIREBASE_PROJECT_NUMBER=<your_firebase_project_number>
FIREBASE_APP_ID=<your_firebase_app_id>
GOOGLE_APPLICATION_CREDENTIALS=/app/firebase-service-account.json
FIREBASE_SERVICE_ACCOUNT_BASE64=<optional_base64_encoded_service_account_json>
